# systemd user unit for middle-manager (example).
#
# Install:
#   mkdir -p ~/.config/systemd/user
#   cp deploy/middle-manager.service ~/.config/systemd/user/
#   # edit WorkingDirectory (and ExecStart if node is not /usr/bin/node; check with: command -v node)
#   systemctl --user daemon-reload
#   systemctl --user enable --now middle-manager
#   loginctl enable-linger "$USER"     # keep it running when you are logged out
#
# Logs go to journald only (journalctl --user -u middle-manager), never to a growing file.

[Unit]
Description=middle-manager: dashboard and API for a fleet of AI coding agents
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# The clone of the repo; config/middle-manager.yaml and data/ live here.
WorkingDirectory=%h/middle-manager
ExecStart=/usr/bin/node server/index.ts --config config/middle-manager.yaml
Environment=NODE_ENV=production
Restart=on-failure
RestartSec=5
MemoryMax=512M
StandardOutput=journal
StandardError=journal
# Light hardening that still lets collectors read files in your home folder.
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=default.target
